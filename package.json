    "windsurf",
    "llm",
    "prompt",
    "developer-tools",
    "observability",
    "research"
  ],
  "homepage": "https://github.com/ravid7000/skills#readme",
  "bugs": "https://github.com/ravid7000/skills/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravid7000/skills.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "skills",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
